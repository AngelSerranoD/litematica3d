{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de la ventana principal: escuchar eventos (abrir archivo, soltar archivos, redimensionar, cerrar), controles de la barra de título propia y diálogo de abrir (el de guardar lo abre Rust)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "ms-windows-store://review/?ProductId=9P3WWV65DTR6"
        },
        {
          "url": "https://apps.microsoft.com/detail/9P3WWV65DTR6"
        }
      ]
    }
  ]
}
