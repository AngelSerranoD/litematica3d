{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Litematica3D",
  "version": "../package.json",
  "identifier": "com.aserrano.litematica3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Litematica3D",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/biblioteca/*.miniatura.png"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Ángel Serrano Domínguez",
    "copyright": "© Ángel Serrano Domínguez. Todos los derechos reservados.",
    "shortDescription": "Visor y biblioteca de schematics de Minecraft",
    "longDescription": "Visor 3D y biblioteca local de schematics de Minecraft (.litematic, .schem, .schematic), sin conexión.",
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "resources": {
      "../NOTICE": "NOTICE",
      "../src/assets/fuentes/OFL.txt": "licencias/OFL.txt"
    },
    "fileAssociations": [
      {
        "ext": [
          "litematic"
        ],
        "name": "Schematic de Minecraft (.litematic)",
        "description": "Schematic de Minecraft (.litematic)",
        "role": "Viewer"
      },
      {
        "ext": [
          "schem"
        ],
        "name": "Schematic de Minecraft (.schem)",
        "description": "Schematic de Minecraft (.schem)",
        "role": "Viewer"
      },
      {
        "ext": [
          "schematic"
        ],
        "name": "Schematic de Minecraft (.schematic)",
        "description": "Schematic de Minecraft (.schematic)",
        "role": "Viewer"
      },
      {
        "ext": [
          "nbt"
        ],
        "name": "Estructura de Minecraft (.nbt)",
        "description": "Estructura de Minecraft (.nbt)",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
